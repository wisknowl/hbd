// HBD Foundation — PostgreSQL Database Schema
// Database Engine: PostgreSQL 16
// ORM: Prisma Client

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CelebrationCategory {
  BIRTHDAY
  BEGINNING
  MILESTONE
  ANNIVERSARY
  ACHIEVEMENT
  COMMUNITY
}

enum PackageTier {
  MINI
  CLASSIC
  PREMIUM
  SIGNATURE
  GLOBAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  DELIVERED
  CANCELLED
}

enum ReactionType {
  CONFETTI
  HEART
  TOAST
  SPARK
  CROWN
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  handle          String        @unique
  fullName        String
  avatarUrl       String?
  bio             String?
  countryCode     String?       @default("CM")
  phoneNumber     String?
  birthDate       DateTime?
  isVerified      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  celebrations    Celebration[]
  posts           Post[]
  reactions       Reaction[]
  comments        Comment[]
  bookings        Booking[]
  reminders       Reminder[]
  memoryVault     MemoryVaultItem[]

  // Social Graph
  followers       Follow[]      @relation("UserFollowers")
  following       Follow[]      @relation("UserFollowing")

  @@index([handle])
  @@index([email])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Celebration {
  id          String              @id @default(uuid())
  creatorId   String
  title       String
  category    CelebrationCategory
  eventDate   DateTime
  location    String
  story       String              @db.Text
  coverImage  String?
  isPublic    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  creator     User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  posts       Post[]
  bookings    Booking[]
  memories    MemoryVaultItem[]

  @@index([category])
  @@index([eventDate])
}

model Post {
  id              String       @id @default(uuid())
  userId          String
  celebrationId   String?
  mediaUrl        String
  mediaType       String       @default("video") // video | image
  thumbnailUrl    String?
  caption         String       @db.Text
  audioTrack      String       @default("Original Audio - HBD Sound")
  viewCount       Int          @default(0)
  cheerCount      Int          @default(0)
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebration     Celebration? @relation(fields: [celebrationId], references: [id], onDelete: SetNull)
  reactions       Reaction[]
  comments        Comment[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Reaction {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType @default(CONFETTI)
  createdAt DateTime     @default(now())

  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  celebrationId   String?
  packageTier     PackageTier
  celebrantName   String
  targetDate      DateTime
  location        String
  guestCount      Int?
  selectedAddons  String[]
  specialNotes    String?       @db.Text
  budgetEstimated Decimal?      @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebration     Celebration?  @relation(fields: [celebrationId], references: [id], onDelete: SetNull)
}

model Reminder {
  id                  String              @id @default(uuid())
  userId              String
  title               String
  celebrantName       String
  category            CelebrationCategory
  eventDate           DateTime
  remindDaysBefore    Int                 @default(30)
  isNotified          Boolean             @default(false)
  createdAt           DateTime            @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventDate])
}

model MemoryVaultItem {
  id            String       @id @default(uuid())
  userId        String
  celebrationId String?
  title         String
  mediaUrl      String
  mediaType     String       // image | video | tribute_letter
  recordedYear  Int
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebration   Celebration? @relation(fields: [celebrationId], references: [id], onDelete: SetNull)
}
