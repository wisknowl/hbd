{
  "expo": {
    "name": "HBD",
    "slug": "hbd-foundation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B2A86"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hbdfoundation.celebrate"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B2A86"
      },
      "package": "com.hbdfoundation.celebrate"
    },
    "androidNavigationBar": {
      "visible": true,
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "a50991cf-e6de-4682-866f-02c905cb96e9"
      }
    },
    "owner": "wisknowl"
  }
}
