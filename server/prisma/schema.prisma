// HBD Foundation — PostgreSQL Database Schema
// Database Engine: PostgreSQL 16
// ORM: Prisma Client

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum CelebrationCategory {
  BIRTHDAY
  BEGINNING
  MILESTONE
  ANNIVERSARY
  ACHIEVEMENT
  COMMUNITY
  FAITH
  TRIBUTE
}

enum PackageTier {
  MINI
  CLASSIC
  PREMIUM
  SIGNATURE
  GLOBAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  DELIVERED
  CANCELLED
}

enum ReactionType {
  CONFETTI
  HEART
  TOAST
  SPARK
  CROWN
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  handle          String        @unique
  fullName        String
  avatarUrl       String?
  bio             String?
  countryCode     String?       @default("CM")
  phoneNumber     String?
  passwordHash    String?
  city            String?       @default("London")
  country         String?       @default("United Kingdom")
  birthDay        Int?          @default(24)
  birthMonth      Int?          @default(10)
  birthYear       Int?          @default(1996)
  birthDate       DateTime?
  isVerified      Boolean       @default(false)
  traditions      String[]      @default([])
  showTributes    Boolean       @default(true)
  wishlist        String[]      @default([])
  avoidList       String[]      @default([])
  idols           String[]      @default([])
  musicGenres     String[]      @default([])
  animalTypes     String[]      @default([])
  hobbies         String[]      @default([])
  personalGoals   String[]      @default([])
  preferences     Json?
  privacy         Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  celebrations    Celebration[]
  posts           Post[]
  reactions       Reaction[]
  comments        Comment[]
  bookings        Booking[]
  reminders       Reminder[]
  memoryVault     MemoryVaultItem[]

  // Social Graph
  followers       Follow[]      @relation("UserFollowers")
  following       Follow[]      @relation("UserFollowing")

  // Gifting Engine
  giftsGiven      GiftOrder[]   @relation("GiftsGiven")
  giftsReceived   GiftOrder[]   @relation("GiftsReceived")

  @@index([handle])
  @@index([email])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Celebration {
  id          String              @id @default(uuid())
  creatorId   String
  title       String
  category    CelebrationCategory
  eventDate   DateTime
  location    String
  story       String              @db.Text
  coverImage  String?
  isPublic    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  creator     User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  posts       Post[]
  bookings    Booking[]
  memories    MemoryVaultItem[]

  @@index([category])
  @@index([eventDate])
}

model Post {
  id              String       @id @default(uuid())
  userId          String
  celebrationId   String?
  mediaUrl        String
  mediaType       String       @default("video") // video | image
  thumbnailUrl    String?
  caption         String       @db.Text
  audioTrack      String       @default("Original Audio - HBD Sound")
  viewCount       Int          @default(0)
  cheerCount      Int          @default(0)
  createdAt       DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebration     Celebration? @relation(fields: [celebrationId], references: [id], onDelete: SetNull)
  reactions       Reaction[]
  comments        Comment[]

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model Reaction {
  id        String       @id @default(uuid())
  postId    String
  userId    String
  type      ReactionType @default(CONFETTI)
  createdAt DateTime     @default(now())

  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, type])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  celebrationId   String?
  packageTier     PackageTier
  celebrantName   String
  targetDate      DateTime
  location        String
  guestCount      Int?
  selectedAddons  String[]
  specialNotes    String?       @db.Text
  budgetEstimated Decimal?      @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebration     Celebration?  @relation(fields: [celebrationId], references: [id], onDelete: SetNull)
}

model Reminder {
  id                  String              @id @default(uuid())
  userId              String
  title               String
  celebrantName       String
  category            CelebrationCategory
  eventDate           DateTime
  remindDaysBefore    Int                 @default(30)
  isNotified          Boolean             @default(false)
  createdAt           DateTime            @default(now())

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventDate])
}

model MemoryVaultItem {
  id            String       @id @default(uuid())
  userId        String
  celebrationId String?
  title         String
  mediaUrl      String
  mediaType     String       // image | video | tribute_letter
  recordedYear  Int
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  celebration   Celebration? @relation(fields: [celebrationId], references: [id], onDelete: SetNull)
}

enum SurpriseStatus {
  PLANNING
  LOCKED
  DELIVERED
}

enum SurpriseVisibility {
  PRIVATE
  PUBLIC
}

enum ContributionType {
  VIDEO
  PHOTO
  VOICE_NOTE
  LETTER
  MONEY
  PHYSICAL_GIFT
  DIGITAL_GIFT
  SERVICE
}

model SurprisePackage {
  id                  String             @id @default(uuid())
  title               String
  celebrantId         String
  celebrantName       String
  celebrantAvatar     String?
  celebrantBirthDate  DateTime
  organizerId         String
  status              SurpriseStatus     @default(PLANNING)
  visibility          SurpriseVisibility @default(PRIVATE)
  targetDeliveryDate  DateTime
  deliveredAt         DateTime?
  hasPooledGoal       Boolean            @default(false)
  pooledGoalAmount    Decimal?           @db.Decimal(10, 2)
  currentPooledAmount Decimal            @default(0.00) @db.Decimal(10, 2)
  currency            String             @default("USD")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  contributions       SurpriseContribution[]
  messages            SurpriseMessage[]

  @@index([celebrantId])
  @@index([organizerId])
  @@index([status])
}

model SurpriseContribution {
  id                      String           @id @default(uuid())
  packageId               String
  contributorId           String
  contributorName         String
  type                    ContributionType
  mediaUrl                String?
  thumbnailUrl            String?
  messageText             String?          @db.Text
  giftTitle               String?
  giftDescription         String?          @db.Text
  estimatedValue          Decimal?         @db.Decimal(10, 2)
  amountContributed       Decimal?         @db.Decimal(10, 2)
  currency                String?          @default("USD")
  isFlaggedForCompilation Boolean          @default(false)
  compilationOrder        Int?
  submittedAt             DateTime         @default(now())

  package                 SurprisePackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model SurpriseMessage {
  id          String          @id @default(uuid())
  packageId   String
  senderId    String
  senderName  String
  text        String          @db.Text
  mediaUrl    String?
  createdAt   DateTime        @default(now())

  package     SurprisePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

enum InspirationDomain {
  TECH_BUSINESS
  MUSIC_ARTS
  SPORTS_PIONEERS
  HUMANITARIAN_LEADERS
  SCIENCE_DISCOVERY
  EARTH_NATURE
  FAITH_PHILOSOPHY
}

enum CelebrationTone {
  FESTIVE
  TRIBUTE
}

enum CommercialIntent {
  GIFT
  POT
  TOAST
  EXPERIENCE
}

enum CalendarScope {
  CIRCLE
  LOCAL
  COUNTRY
  CONTINENT
  GLOBAL
}

model CalendarEvent {
  id                String             @id @default(uuid())
  title             String
  subtitle          String?
  category          CelebrationCategory
  domain            InspirationDomain?
  tone              CelebrationTone    @default(FESTIVE)
  commercialIntent  CommercialIntent   @default(TOAST)
  countryCode       String?            @default("GLOBAL")
  heritageTradition String?
  defaultMonth      Int                // 1-12
  defaultDay        Int                // 1-31
  isFloatingLunar   Boolean            @default(false)
  summary           String?            @db.Text
  toastCount        Int                @default(0)
  createdAt         DateTime           @default(now())

  occurrences       EventOccurrence[]

  @@index([category])
  @@index([countryCode])
  @@index([defaultMonth, defaultDay])
}

model EventOccurrence {
  id             String        @id @default(uuid())
  eventId        String
  year           Int
  month          Int           // 1-12
  day            Int           // 1-31
  exactDate      DateTime      @db.Date

  event          CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, year])
  @@index([year, month, day])
}

// =============================================================
// Universal Gifting Engine & Merchant Partner Models
// =============================================================

enum MerchantCategory {
  GLOBAL_ECOMMERCE
  REGIONAL_ECOMMERCE
  PHYSICAL_PARTNER
  GIFTCARD_AGGREGATOR
  HUMANITARIAN_PARTNER
  TELCO_AGGREGATOR
}

enum GiftCategory {
  FLOWERS
  CAKE
  TECH
  FASHION
  FRAGRANCE
  EXPERIENCE
  DIGITAL
  HUMANITARIAN
  CONNECTIVITY
  TRIBUTE
}

enum FulfillmentType {
  EMOTIONAL_TRIBUTE       // 100% Universal: Voice, Video, Letters, Memory Capsule (Active in every country on Earth)
  HUMANITARIAN_MILESTONE  // Universal impact: HBD Gives celebratory meal, emergency aid, clean water in celebrant's honor
  MOBILE_CONNECTIVITY     // 160+ countries: Airtime, SMS, and data bundle top-up
  GIFTCARD_BRAND          // Digital closed-loop gift cards (Amazon, Apple, Spotify, Uber)
  GIFTCARD_OPEN_LOOP      // Virtual Visa / Mastercard spendable globally online
  NATIVE_ESCROW           // Handcrafted local delivery (Douala, Lagos, Nairobi) held in HBD escrow
  AFFILIATE_REDIRECT      // Direct outbound links to Amazon, Jumia, etc.
}

enum GiftOrderStatus {
  ESCROWED
  AWAITING_RECIPIENT
  CONFIRMED
  DISPATCHED
  DELIVERED
  REDEEMED
  CANCELLED
}

enum GiftDeliveryType {
  SHIPPING
  STORE_PICKUP_QR
  DIGITAL
  INSTANT_DIGITAL_CODE
  AIRTIME_RECHARGE
  HUMANITARIAN_IMPACT
}

model CountryRoute {
  id                    String            @id @default(uuid())
  countryCode           String            @unique // ISO 2-letter (e.g. "CM", "NG", "UA", "SD", "SY", "US", "GLOBAL")
  countryName           String
  region                String            // "AFRICA", "EUROPE", "AMERICAS", "CONFLICT_OR_FRONTIER", "GLOBAL"
  primaryCurrency       String            @default("USD")
  allowedFulfillment    FulfillmentType[]
  isConflictOrCrisisZone Boolean          @default(false)
  supportNote           String?           // e.g. "Emotional first reach & humanitarian milestone support enabled"
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([countryCode])
  @@index([region])
}

model MerchantPartner {
  id                  String             @id @default(uuid())
  slug                String             @unique
  name                String
  category            MerchantCategory   @default(GLOBAL_ECOMMERCE)
  logoUrl             String?
  description         String?            @db.Text
  supportedCountries  String[]           @default(["GLOBAL"])
  supportedCurrencies String[]           @default(["USD"])
  commissionRate      Decimal            @default(0.10) @db.Decimal(5, 4)
  isActive            Boolean            @default(true)
  isVerified          Boolean            @default(true)
  posSecretKey        String?            // For physical store QR scanner verification
  physicalAddress     String?
  city                String?
  country             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  items               GiftCatalogItem[]
  orders              GiftOrder[]

  @@index([slug])
  @@index([category])
}

model GiftCatalogItem {
  id                    String             @id @default(uuid())
  merchantId            String
  sku                   String             @unique
  title                 String
  description           String?            @db.Text
  category              GiftCategory       @default(TECH)
  fulfillmentType       FulfillmentType    @default(GIFTCARD_BRAND)
  brandSlug             String?
  countryCode           String             @default("GLOBAL")
  denominationType      String             @default("FIXED") // FIXED | VARIABLE
  minAmount             Decimal?           @db.Decimal(10, 2)
  maxAmount             Decimal?           @db.Decimal(10, 2)
  humanitarianCause     String?            // e.g. "Celebration Meal for Orphanage", "Emergency Aid"
  price                 Decimal            @db.Decimal(10, 2)
  currency              String             @default("USD")
  imageUrl              String
  externalUrl           String?
  isPhysicalStore       Boolean            @default(false)
  deliveryScope         String             @default("GLOBAL")
  inStock               Boolean            @default(true)
  rating                Decimal?           @default(4.9) @db.Decimal(2, 1)
  estimatedDeliveryDays Int                @default(3)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  merchant              MerchantPartner    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders                GiftOrder[]

  @@index([merchantId])
  @@index([category])
  @@index([fulfillmentType])
  @@index([countryCode])
}

model GiftOrder {
  id                  String             @id @default(uuid())
  orderNumber         String             @unique
  giverId             String
  recipientId         String
  merchantId          String
  itemId              String
  status              GiftOrderStatus    @default(ESCROWED)
  fulfillmentType     FulfillmentType    @default(GIFTCARD_BRAND)
  totalAmount         Decimal            @db.Decimal(10, 2)
  currency            String             @default("USD")
  greetingMessage     String?            @db.Text
  tributeMediaUrl     String?
  deliveryType        GiftDeliveryType   @default(SHIPPING)

  // Digital Gift Card & Airtime Fulfillment
  claimCode           String?
  claimPin            String?
  claimUrl            String?

  // Humanitarian milestone tribute certificate
  humanitarianCertUrl String?

  // Fulfillment & tracking
  trackingNumber      String?
  carrierName         String?
  estimatedDelivery   DateTime?

  // Physical store dynamic voucher
  voucherCode         String?            @unique
  voucherQrPayload    String?
  voucherRedeemedAt   DateTime?
  cashierNote         String?

  // Recipient appreciation
  thankYouNote        String?            @db.Text
  thankYouMediaUrl    String?
  thankYouEmoji       String?            @default("❤️")

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  giver               User               @relation("GiftsGiven", fields: [giverId], references: [id], onDelete: Cascade)
  recipient           User               @relation("GiftsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  merchant            MerchantPartner    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  item                GiftCatalogItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  shippingAddress     RecipientShippingAddress?

  @@index([giverId])
  @@index([recipientId])
  @@index([status])
  @@index([fulfillmentType])
  @@index([voucherCode])
}

model RecipientShippingAddress {
  id                    String             @id @default(uuid())
  orderId               String             @unique
  streetAddress         String
  city                  String
  stateOrProvince       String?
  postalCode            String?
  country               String
  deliveryInstructions  String?
  phoneNumber           String?
  createdAt             DateTime           @default(now())

  order                 GiftOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
}


